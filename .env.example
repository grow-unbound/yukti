# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# PostHog (feature flags + analytics)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
# Personal API key — used server-side to call PostHog custom endpoint API (Buyer App dashboard analytics cards)
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key_here

# Cloudflare R2 (file storage)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=yukti-assets
R2_PUBLIC_URL=https://assets.yukti.so
NEXT_PUBLIC_R2_BASE_URL=https://assets.yukti.so
IMAGE_UPLOAD_WORKER_URL=https://images.yukti.so
IMAGE_UPLOAD_SHARED_SECRET=replace_with_the_same_secret_configured_on_yukti_image_worker

# Resend (email)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="Yukti <onboarding@your-domain.example>"

# WhatsApp (Meta Cloud API — direct, no BSP)
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_TOKEN=your_meta_whatsapp_cloud_api_token_here
WHATSAPP_ADMIN_NUMBER=919876543210
# Platform tenant UUID — OTP auth messages debit this tenant's WhatsApp wallet
WHATSAPP_PLATFORM_TENANT_ID=your_platform_tenant_uuid_here

# WhatsApp Embedded Signup (per-tenant WABA connect via Meta) — Tech Provider App
META_APP_ID=your_meta_app_id_here
NEXT_PUBLIC_META_APP_ID=your_meta_app_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_EMBEDDED_SIGNUP_CONFIGURATION_ID=your_facebook_login_for_business_config_id_here
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIGURATION_ID=your_facebook_login_for_business_config_id_here

# Zoho Integration — Platform-level OAuth credentials (set once by Yukti developer)
# Create a "Server-based Application" at https://api-console.zoho.in → copy Client ID + Secret
# Set Redirect URI to: https://{your-domain}/api/settings/integrations/zoho/oauth/callback
ZOHO_OAUTH_CLIENT_ID=your_zoho_oauth_client_id_here
ZOHO_OAUTH_CLIENT_SECRET=your_zoho_oauth_client_secret_here
# 'in' for India DC (zoho.in / zohoapis.in), 'com' for US/global
ZOHO_DC=in

# App configuration
NEXT_PUBLIC_APP_URL=https://app.yukti.so
# Server-to-server base URL for Supabase edge functions calling Next.js internal routes (e.g. transaction WhatsApp notify)
YUKTI_APP_URL=https://app.yukti.so
NEXT_PUBLIC_API_URL=https://api.yukti.so
BUYER_PREVIEW_TOKEN_SECRET=replace_with_a_long_random_secret

# Google Maps
# Client-side key (Places autocomplete + reverse geocode in browser) — restrict to your domain in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
# Server-side key (geocoding in Supabase edge functions / integration sync)
GOOGLE_MAPS_API_KEY=your_google_maps_server_key_here

NODE_ENV=development

# Sentry (error monitoring — longer retention than Supabase/Vercel's 7-day logs)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_sentry_org_slug_here
SENTRY_PROJECT=your_sentry_project_slug_here
# Build-time only (source map upload) — never expose as NEXT_PUBLIC_
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Cloudflare Turnstile (bot protection on signup form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Embeddings (optional — leave blank to disable semantic search entirely)
EMBEDDING_PROVIDER=          # openai | local (leave blank to disable)
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=              # required only if EMBEDDING_PROVIDER=openai
LOCAL_EMBEDDING_URL=         # required only if EMBEDDING_PROVIDER=local
