{
  "model": "sonnet",
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "12000"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "linear@claude-plugins-official": false,
    "Notion@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "serena@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "greptile@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "huggingface-skills@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "posthog@claude-plugins-official": false
  },
  "skillOverrides": {
    "agents-sdk": "user-invocable-only",
    "cloudflare-email-service": "user-invocable-only",
    "cloudflare-one": "user-invocable-only",
    "cloudflare-one-migrations": "user-invocable-only",
    "durable-objects": "user-invocable-only",
    "sandbox-sdk": "user-invocable-only",
    "turnstile-spin": "user-invocable-only",
    "web-perf": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*__(execute_sql|apply_migration|deploy_edge_function|merge_branch|reset_branch|rebase_branch|create_branch|delete_branch|pause_project|restore_project|create_project|confirm_cost|query_logs|get_advisors|list_tables|list_extensions|list_migrations|list_edge_functions|get_edge_function|list_branches|generate_typescript_types|get_project|get_organization|list_projects|list_organizations|get_project_url|get_publishable_keys|get_cost|search_docs)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-prod.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/wrap-nudge.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*__(execute_sql|apply_migration|deploy_edge_function|merge_branch|reset_branch|rebase_branch|create_branch|delete_branch|pause_project|restore_project|create_project|confirm_cost|query_logs|get_advisors|list_tables|list_extensions|list_migrations|list_edge_functions|get_edge_function|list_branches|generate_typescript_types|get_project|get_organization|list_projects|list_organizations|get_project_url|get_publishable_keys|get_cost|search_docs)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/prod_sql_guard.py\" post"
          }
        ]
      }
    ]
  }
}
